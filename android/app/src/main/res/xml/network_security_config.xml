<?xml version="1.0" encoding="utf-8"?>
<!--
  IPTV providers and local streams are often plain http, so cleartext stays allowed for everything the person points the app at. The app's own service endpoints are different:
  TMDB, fanart.tv, TheTVDB, TVmaze, OpenSubtitles, Trakt, Wikipedia and the update check (the GitHub API) are always https. Keep this list equal to the iOS ATS list (Scripts/check-host-parity.py checks it). raw.githubusercontent.com and github.com are not listed: a person's own playlist may live there on plain http, and a downgrade to http is refused for them.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">themoviedb.org</domain>
        <domain includeSubdomains="true">tmdb.org</domain>
        <domain includeSubdomains="true">fanart.tv</domain>
        <domain includeSubdomains="true">thetvdb.com</domain>
        <domain includeSubdomains="true">tvmaze.com</domain>
        <domain includeSubdomains="true">opensubtitles.com</domain>
        <domain includeSubdomains="true">trakt.tv</domain>
        <domain includeSubdomains="true">wikipedia.org</domain>
        <domain includeSubdomains="true">wikimedia.org</domain>
        <domain includeSubdomains="true">itunes.apple.com</domain>
        <domain includeSubdomains="true">youtube.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">groq.com</domain>
        <domain includeSubdomains="true">openai.com</domain>
        <domain includeSubdomains="true">anthropic.com</domain>
        <domain includeSubdomains="true">openrouter.ai</domain>
        <domain includeSubdomains="true">nvidia.com</domain>
        <domain includeSubdomains="true">ollama.com</domain>
        <domain includeSubdomains="true">real-debrid.com</domain>
        <domain includeSubdomains="true">alldebrid.com</domain>
        <domain includeSubdomains="true">premiumize.me</domain>
        <domain includeSubdomains="false">api.github.com</domain>
        <domain includeSubdomains="false">iptv-org.github.io</domain>
    </domain-config>
</network-security-config>
