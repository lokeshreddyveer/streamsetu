<Page
    x:Class="StreamSetu.App.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="8" Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderRow" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Back" Click="OnBack" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" TextTrimming="CharacterEllipsis" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="SubText" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ProgressRing x:Name="Busy" Grid.Column="2" IsActive="False" Width="24" Height="24" />
        </Grid>

        <!-- mpv draws into a separate window that is placed exactly over this area. -->
        <Border x:Name="VideoArea" Grid.Row="1" Background="Black" SizeChanged="OnVideoAreaChanged" />

        <InfoBar x:Name="Message" Grid.Row="2" IsOpen="False" IsClosable="False" Severity="Error" />

        <Grid x:Name="ControlsRow" Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PauseButton" Content="Pause" Click="OnPause" MinWidth="72" />
            <Button x:Name="BackTen" Content="−10 s" Grid.Column="1" Click="OnBackTen" />
            <Button x:Name="ForwardTen" Content="+10 s" Grid.Column="2" Click="OnForwardTen" />
            <TextBlock x:Name="TimeText" Grid.Column="3" VerticalAlignment="Center" MinWidth="110" />
            <Slider x:Name="SeekBar" Grid.Column="4" Minimum="0" Maximum="1" IsThumbToolTipEnabled="False" PointerCaptureLost="OnSeekReleased" />
            <TextBlock Text="Volume" Grid.Column="5" VerticalAlignment="Center" />
            <Slider x:Name="VolumeBar" Grid.Column="6" Minimum="0" Maximum="150" Value="100" ValueChanged="OnVolume" />
            <Button Content="Full screen" Grid.Column="7" Click="OnFullScreen" />
        </Grid>

        <!-- The slim bar shown in the mini player, in place of the full controls. -->
        <StackPanel x:Name="PipBar" Grid.Row="3" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
            <Button x:Name="PipPause" Content="Pause" Click="OnPause" MinWidth="72" />
            <Button Content="Restore" Click="OnMini" />
            <Button Content="Close" Click="OnBack" />
        </StackPanel>

        <StackPanel x:Name="ToolsRow" Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <Button x:Name="SkipButton" Content="Skip intro" Visibility="Collapsed" Click="OnSkip" Style="{StaticResource AccentButtonStyle}" />
            <Button Content="Audio" Click="OnAudio" />
            <Button Content="Subtitles" Click="OnSubtitles" />
            <Button Content="Speed" Click="OnSpeed" />
            <Button Content="Picture" Click="OnPicture" />
            <Button x:Name="SleepButton" Content="Sleep timer" Click="OnSleep" />
            <Button Content="Go to time" Click="OnGoTo" />
            <Button Content="Stats" Click="OnStats" />
            <Button Content="Screenshot" Click="OnScreenshot" />
            <Button Content="Mini player" Click="OnMini" />
            <Button x:Name="NextButton" Content="Next in queue" Click="OnNext" />
        </StackPanel>
    </Grid>
</Page>
