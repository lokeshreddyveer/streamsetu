<Page
    x:Class="StreamSetu.App.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:core="using:StreamSetu.Core"
    xmlns:local="using:StreamSetu.App">
    <Page.Resources>
        <!-- The surfaces of this page: white at 5% with a 10% hairline; teal only for icons, focus and the hover edge. -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="SurfaceEdgeBrush" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="TealBrush" Color="#3CC6D6" />
        <LinearGradientBrush x:Key="IconSquareBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#473CC6D6" Offset="0" />
            <GradientStop Color="#003CC6D6" Offset="1" />
        </LinearGradientBrush>

        <!-- One connection type on the welcome screen: icon in a rounded square, title, one line under it. -->
        <DataTemplate x:Key="TileTemplate" x:DataType="local:ConnectionTile">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="12" VerticalAlignment="Center" Background="{StaticResource IconSquareBrush}">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" Foreground="{StaticResource TealBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Subtitle}" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="TileButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="MinHeight" Value="84" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource TealBrush}" />
            <Setter Property="ContentTemplate" Value="{StaticResource TileTemplate}" />
        </Style>
    </Page.Resources>

    <!-- This page is always dark, whatever the app theme: the brand symbol is made for a dark backdrop. -->
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#05080C">
        <!-- Two soft glows and a vignette, no hard edges. Windows before 1903 does not draw gradients, so there they fall back to nothing. -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <media:RadialGradientBrush Center="0.24,0.32" GradientOrigin="0.24,0.32" RadiusX="0.5" RadiusY="0.7" FallbackColor="Transparent">
                    <GradientStop Color="#2E1FA7B8" Offset="0" />
                    <GradientStop Color="#121FA7B8" Offset="0.5" />
                    <GradientStop Color="#001FA7B8" Offset="1" />
                </media:RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <media:RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="0.55" RadiusY="0.75" FallbackColor="Transparent">
                    <GradientStop Color="#128FA7C0" Offset="0" />
                    <GradientStop Color="#008FA7C0" Offset="1" />
                </media:RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <media:RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.85" RadiusY="0.85" FallbackColor="Transparent">
                    <GradientStop Color="#00000000" Offset="0.55" />
                    <GradientStop Color="#73000000" Offset="1" />
                </media:RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer>
            <Grid x:Name="Columns" Padding="48,40,48,48" ColumnSpacing="56" RowSpacing="32" MaxWidth="1320" SizeChanged="OnColumnsSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="45*" />
                    <ColumnDefinition x:Name="RightColumn" Width="55*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Welcome, shown while there is no connection yet. -->
                <StackPanel x:Name="HeroPanel" Spacing="14" VerticalAlignment="Center">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="14" IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>
                    <Image x:Name="BrandImage" MaxWidth="260" MaxHeight="260" HorizontalAlignment="Left" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="STREAMSETU" FontSize="13" FontWeight="SemiBold" CharacterSpacing="240" Foreground="{StaticResource TealBrush}" />
                    <TextBlock x:Name="Headline" Text="Your streams. One home." FontSize="48" FontWeight="Bold" CharacterSpacing="-20" LineHeight="54" TextWrapping="Wrap" />
                    <TextBlock Text="Bring the playlists, logins and media servers you already have. StreamSetu keeps them together and plays them." FontSize="16" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Spacing="10" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{StaticResource TealBrush}" />
                            <TextBlock Text="Logins stay encrypted on this device" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F8;" FontSize="14" Foreground="{StaticResource TealBrush}" />
                            <TextBlock Text="No account needed" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7B8;" FontSize="14" Foreground="{StaticResource TealBrush}" />
                            <TextBlock Text="Nothing is included: you bring your own" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- The saved connections, shown once there is at least one. -->
                <StackPanel x:Name="SavedPanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="Connections" Style="{StaticResource TitleTextBlockStyle}" />
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceEdgeBrush}" BorderThickness="1" CornerRadius="16" Padding="8">
                        <ListView x:Name="SavedList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:Playlist">
                                    <Grid ColumnSpacing="12" Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Address}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Remove" Tag="{x:Bind Id}" Click="OnRemove" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <local:PointerButton x:Name="AddButton" Click="OnAddConnection" AutomationProperties.Name="Add a connection">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Add a connection" />
                        </StackPanel>
                    </local:PointerButton>
                </StackPanel>

                <!-- Choosing a type, then filling it in. The same two views serve the first start and every later connection. -->
                <StackPanel x:Name="SetupPanel" Grid.Column="1" Spacing="16" VerticalAlignment="Center" SizeChanged="OnSetupSizeChanged">
                    <StackPanel x:Name="ChooserView" Spacing="16">
                        <TextBlock Text="Or choose how you connect" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid x:Name="TileGrid" ColumnSpacing="12" RowSpacing="12">
                            <!-- Hover and press for the tiles: hover lifts (more fill, teal edge), pressed is dimmer (and smaller, see PointerButton). -->
                            <Grid.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#17FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0AFFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#993CC6D6" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#993CC6D6" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#C8FFFFFF" />
                            </Grid.Resources>
                            <Grid.ChildrenTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="14" IsStaggeringEnabled="True" />
                                </TransitionCollection>
                            </Grid.ChildrenTransitions>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="FormView" Spacing="16" Visibility="Collapsed">
                        <HyperlinkButton x:Name="BackLink" Click="OnBackToTypes" Padding="0,4" AutomationProperties.Name="All connection types">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72B;" FontSize="12" />
                                <TextBlock Text="All connection types" />
                            </StackPanel>
                        </HyperlinkButton>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="12" VerticalAlignment="Center" Background="{StaticResource IconSquareBrush}">
                                <FontIcon x:Name="FormIcon" FontSize="22" Foreground="{StaticResource TealBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="FormTitle" FontSize="28" FontWeight="Bold" CharacterSpacing="-10" TextWrapping="Wrap" />
                                <TextBlock x:Name="FormSubtitle" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceEdgeBrush}" BorderThickness="1" CornerRadius="16" Padding="24">
                            <StackPanel Spacing="16">
                                <!-- The members of a group tile (for example Jellyfin, Emby or Plex). Hidden for a tile with one type. -->
                                <RadioButtons x:Name="MemberChooser" Header="Type" MaxColumns="3" SelectionChanged="OnMemberChanged" Visibility="Collapsed" />
                                <!-- The full list of types still drives the fields, Test and Save; the tiles and the chooser above set it. -->
                                <ComboBox x:Name="KindBox" Header="Type" SelectedIndex="0" SelectionChanged="OnKindChanged" MinWidth="360" Visibility="Collapsed">
                                    <ComboBoxItem Content="Xtream Codes (server, user name, password)" />
                                    <ComboBoxItem Content="M3U link" />
                                    <ComboBoxItem Content="M3U file on this computer" />
                                    <ComboBoxItem Content="HDHomeRun" />
                                    <ComboBoxItem Content="TVHeadend" />
                                    <ComboBoxItem Content="Enigma2 receiver" />
                                    <ComboBoxItem Content="Jellyfin" />
                                    <ComboBoxItem Content="Emby" />
                                    <ComboBoxItem Content="Plex" />
                                    <ComboBoxItem Content="WebDAV server" />
                                    <ComboBoxItem Content="Folder of video files on this computer" />
                                    <ComboBoxItem Content="Stalker / Ministra portal (MAC address)" />
                                </ComboBox>
                                <TextBox x:Name="NameBox" Header="Name" PlaceholderText="My provider" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AddressBox" Header="Address" PlaceholderText="http://server.example:8080" />
                                    <local:PointerButton x:Name="BrowseButton" Grid.Column="1" Content="Choose…" VerticalAlignment="Bottom" Click="OnBrowse" Visibility="Collapsed" />
                                </Grid>
                                <TextBox x:Name="UserBox" Header="User name" />
                                <PasswordBox x:Name="PassBox" Header="Password" />
                                <TextBlock x:Name="Hint" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <local:PointerButton x:Name="SaveButton" Content="Connect" MinWidth="120" Style="{StaticResource AccentButtonStyle}" Click="OnSave" />
                            <local:PointerButton x:Name="TestButton" Content="Test" MinWidth="88" Click="OnTest" />
                            <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24" />
                        </StackPanel>
                        <InfoBar x:Name="Message" IsOpen="False" IsClosable="True" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
