<Page
    x:Class="StreamSetu.App.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StreamSetu.App">
    <Grid Padding="24,24,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <ComboBox x:Name="PlaylistBox" Grid.Column="1" MinWidth="220" Visibility="Collapsed" SelectionChanged="OnPlaylistChanged" DisplayMemberPath="Name" />
            <ProgressRing x:Name="Busy" Grid.Column="2" IsActive="False" Width="24" Height="24" />
        </Grid>

        <InfoBar x:Name="Message" Grid.Row="1" IsOpen="False" IsClosable="False" />

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search by name or folder" TextChanged="OnSearchChanged" />
            <ComboBox x:Name="FolderBox" Grid.Column="1" MinWidth="200" SelectionChanged="OnFolderChanged" DisplayMemberPath="Display" />
            <Button x:Name="FolderMenu" Grid.Column="2" Content="Folder" Click="OnFolderMenu" />
            <ComboBox x:Name="SortBox" Grid.Column="3" SelectedIndex="0" SelectionChanged="OnSortChanged">
                <ComboBoxItem Content="Provider order" />
                <ComboBoxItem Content="Name" />
                <ComboBoxItem Content="Recently added" />
                <ComboBoxItem Content="Rating" />
                <ComboBoxItem Content="Year" />
            </ComboBox>
            <Button x:Name="FilterButton" Grid.Column="4" Content="Filter" Click="OnFilterClick" />
        </Grid>

        <TextBlock x:Name="CountText" Grid.Row="3" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />

        <ListView x:Name="ItemList" Grid.Row="4" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnItemClick" RightTapped="OnRightTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:Row">
                    <Grid Padding="4,6" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Mark}" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Image Grid.Column="1" Width="40" Height="40" Stretch="Uniform" Source="{x:Bind local:Logos.Load(LogoUrl)}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Detail}" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
