.DS_Store
# build output
macos/.build*/
macos/.swiftpm/
macos/dist/
macos/third_party/
ios/build/
**/DerivedData/
**/xcuserdata/
*.xcarchive
# signing material and local secrets
*.provisionprofile
*.mobileprovision
*.p12
*.p8
*.pem
.env*
# website
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo
# local databases
*.sqlite
*.sqlite-wal
*.sqlite-shm
# android signing
*.keystore
*.jks
android/keystore.properties
android/**/build/
android/.gradle/
android/local.properties
android/dist/
android/.kotlin/
# windows release files
windows/native/dist/

# optional built-in keys (TMDB, fanart.tv, TheTVDB), generated at build time (scrambled); never committed
macos/Sources/REDDY/Generated/
ios/StreamSetu/Generated/

# the karaoke model, built on demand by macos/Scripts/fetch-karaoke-model.sh; never committed
macos/Resources/Models/

# local result cache of Scripts/checks/run_all.py
Scripts/checks/.stamp.json
Scripts/checks/.stamp.tmp
