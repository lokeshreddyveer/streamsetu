<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime, Developer ID distribution (not sandboxed). -->
    <!-- Allows loading an optional bundled libmpv that is signed with a different identity. -->
    <key>com.apple.security.cs.disable-library-validation</key><true/>
    <!-- Reading the Photos library for On Your Device. -->
    <key>com.apple.security.personal-information.photos-library</key><true/>
</dict>
</plist>
