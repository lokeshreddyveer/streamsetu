<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store / sandboxed build. The database then lives inside the app container. -->
    <key>com.apple.security.app-sandbox</key><true/>
    <key>com.apple.security.network.client</key><true/>
    <key>com.apple.security.network.server</key><true/>   <!-- localhost HLS bridge for MPEG-TS -->
    <key>com.apple.security.files.user-selected.read-only</key><true/>
    <key>com.apple.security.personal-information.photos-library</key><true/>
</dict>
</plist>
